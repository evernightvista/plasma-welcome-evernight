#~ msgctxt "@action:button"
#~ msgid "Learn more about Fedora's license approval standards"
#~ msgstr ""
#~ "Obtenga más información sobre los estándares de aprobación de licencias "
#~ "de Fedora"

#~ msgid "Enable Third Party Repositories"
#~ msgstr "Ativar repositorios de terceros"

