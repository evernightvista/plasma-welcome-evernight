msgid "Support Us on Distrowatch"
msgstr "在Distrowatch支持我们"

#: 02-about-evernight.qml:116
msgctxt "@action:link"
msgid "Evernight Vista Project"
msgstr "Evernight Vista 项目"

#: 02-about-evernight.qml:120
msgctxt "@action:link"
msgid "Fedora Linux Official Website"
msgstr "Fedora Linux 官网"

