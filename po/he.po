msgid "Evernight Vista Project"
msgstr "פרויקט Evernight Vista"

#: 02-about-evernight.qml:120
msgctxt "@action:link"
msgid "Fedora Linux Official Website"
msgstr "האתר הרשמי של פדורה לינוקס"

